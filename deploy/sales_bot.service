[Unit]
Description=Telegram Sales Bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/sales-bot-current
ExecStart=/opt/sales-bot-current/venv/bin/python main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
UMask=0077

[Install]
WantedBy=multi-user.target
