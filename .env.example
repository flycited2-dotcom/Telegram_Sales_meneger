# ==============================
# Telegram Sales Agent — Config
# ==============================

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Supplier (Поставщик) ───────────────────────────────────────────────────────
# Telegram chat_id поставщика (личный чат или группа с ботом)
# Узнать chat_id: перешлите любое сообщение боту @userinfobot
SUPPLIER_TELEGRAM_CHAT_ID=123456789

# Email поставщика (резервный канал уведомлений)
SUPPLIER_EMAIL=supplier@example.com

# ── Email / SMTP (необязательно) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ── Профиль менеджера ─────────────────────────────────────────────────────────
MANAGER_NAME=Алексей
COMPANY_NAME=ТехноТрейд
