# ==============================
# Telegram Sales Agent — Config
# ==============================

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ── Groq API (БЕСПЛАТНО) ──────────────────────────────────────────────────────
# Регистрация без карты: https://console.groq.com
# Бесплатный лимит: 14 400 запросов/день, 500 000 токенов/мин
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Модель (можно оставить по умолчанию)
# Варианты: llama-3.3-70b-versatile | mixtral-8x7b-32768 | gemma2-9b-it
GROQ_MODEL=llama-3.3-70b-versatile

# Optional SOCKS proxy used only for Groq API requests
GROQ_PROXY_URL=

# ── Поставщик ─────────────────────────────────────────────────────────────────
# Telegram chat_id поставщика (узнать: переслать сообщение боту @userinfobot)
SUPPLIER_TELEGRAM_CHAT_ID=123456789

# Email поставщика (резервный канал, если Telegram недоступен)
SUPPLIER_EMAIL=supplier@example.com

# REST API поставщика для синхронизации остатков (необязательно)
# Агент будет вызывать этот URL чтобы получить актуальные остатки перед ответом клиенту
# URL должен возвращать JSON с остатками. Поддерживаемые форматы ответа:
#   {"items": [{"sku": "ART-001", "stock": 10}, ...]}
#   {"products": [{"article": "ART-001", "quantity": 10}, ...]}
#   {"ART-001": 10, "ART-002": 5}   ← sku:количество напрямую
SUPPLIER_API_URL=https://api.your-supplier.com/v1/stock
SUPPLIER_API_KEY=your_supplier_api_key_here

# ── Email / SMTP (необязательно) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ── Профиль менеджера ─────────────────────────────────────────────────────────
MANAGER_NAME=Алексей
COMPANY_NAME=ТехноТрейд
